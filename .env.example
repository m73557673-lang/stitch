# Optional investigation, root-cause, and chatbot providers.
# Supported provider adapters: openai, openai_compatible, anthropic.
# Configure each role independently; never commit real credentials.
AI_AGENT_1_API_KEY=
AI_AGENT_1_PROVIDER=
AI_AGENT_1_MODEL=
AI_AGENT_1_BASE_URL=

AI_AGENT_2_API_KEY=
AI_AGENT_2_PROVIDER=
AI_AGENT_2_MODEL=
AI_AGENT_2_BASE_URL=

CHATBOT_API_KEY=
CHATBOT_PROVIDER=
CHATBOT_MODEL=
CHATBOT_BASE_URL=

# Enables POST /api/alerts/webhook when set. Send the same value in
# the X-Webhook-Token header. Store the real value in Replit Secrets.
ALERT_WEBHOOK_SECRET=

# Optional SQLite path. Defaults to data/incidents.sqlite3.
# INCIDENT_DB_PATH=